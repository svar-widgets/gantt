{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["es2023", "dom"],
		"moduleDetection": "force",
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": false,
		"noImplicitAny": true,
		"declaration": true,
		"emitDeclarationOnly": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"skipLibCheck": true
	},
	"include": ["src", "test"]
}
